# Store every text file with LF line endings, whatever the editor on Windows does.
# start.sh and Dockerfile must be LF to run on Linux; the rest is for consistency.
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
