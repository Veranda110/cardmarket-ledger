# Python
__pycache__/
*.pyc

# All state lives in data/. Only two generic files from it are versioned (see the ! lines):
#   set_names.json / set_meta.json   card lists and set metadata from pokemon-tcg-data (GitHub)
#   cm_expansions.json / cm_expansion_labels.json   which Cardmarket expansion id is which set
#   products_map.json (+ report)     every English Cardmarket product id -> set, number, name, rarity, confidence
# Everything else is either the owner's private collection (binder.json, cards.csv, cm_match.json),
# a nightly download (price_guide_6.json, products_singles_6.json, history/), or generated
# (binder_ledger.html, *.last_good.*).
data/*
!data/set_names.json
!data/set_meta.json
!data/cm_expansions.json
!data/cm_expansion_labels.json
!data/products_map.json
!data/products_map_report.json

# Editor and OS noise
.vscode/
Thumbs.db
.DS_Store
